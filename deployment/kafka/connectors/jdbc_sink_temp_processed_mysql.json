{
  "name": "JdbcSinkConnectorTempProcessedMySQL",
  "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
  "errors.log.include.messages": "false",
  "connection.password": "__DB_PASSWORD__",
  "tasks.max": "1",
  "max.retries": "10",
  "table.types": "TABLE",
  "retry.backoff.ms": "3000",
  "errors.deadletterqueue.context.headers.enable": "false",
  "auto.evolve": "false",
  "db.timezone": "UTC",
  "errors.deadletterqueue.topic.replication.factor": "1",
  "mssql.use.merge.holdlock": "true",
  "tasks.max.enforce": "true",
  "config.action.reload": "restart",
  "errors.log.enable": "false",
  "insert.mode": "upsert",
  "date.timezone": "DB_TIMEZONE",
  "errors.retry.timeout": "0",
  "table.name.format": "kafka_processed_to_db_temp",
  "jdbc.credentials.provider.class": "io.confluent.connect.jdbc.util.DefaultJdbcCredentialsProvider",
  "topics.regex": "processed_.*",
  "batch.size": "3000",
  "connection.attempts": "3",
  "errors.retry.delay.max.ms": "60000",
  "connection.backoff.ms": "10000",
  "key.converter.schemas.enable": "false",
  "delete.enabled": "false",
  "connection.user": "user1",
  "trim.sensitive.log": "false",
  "value.converter.schemas.enable": "false",
  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "io.confluent.connect.json.JsonSchemaConverter",
  "key.converter.schema.registry.url": "http://schema-registry:8081",
  "value.converter.schema.registry.url": "http://schema-registry:8081",
  "errors.tolerance": "none",
  "auto.create": "false",
  "connection.url": "jdbc:mysql://mysql:3306/mqtt_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true",
  "pk.mode": "record_value",
  "pk.fields": "MESSAGE_ID",
  "quote.sql.identifiers": "ALWAYS"
}
