{
  "tenant": "public",
  "namespace": "default",
  "name": "jdbc_sink_pulsar_functions_to_mysql_temp",
  "archive": "/pulsar/connectors/pulsar-io-jdbc-mariadb-4.0.0.nar",
  "inputs": [
    "persistent://public/default/processed_temp"
  ],
  "configs": {
    "jdbcUrl": "jdbc:mariadb://mysql:3306/mqtt_db?useSSL=false&allowPublicKeyRetrieval=true&rewriteBatchedStatements=true",
    "userName": "user1",
    "password": "__DB_PASSWORD__",
    "tableName": "pulsar_processed_to_db_temp",
    "insertMode": "UPSERT",
    "key": "message_id",
    "nonKey": "temperature_fahrenheit,produced_timestamp,pulsar_timestamp,updated_temperature_celsius,processed_timestamp,payload",
    "batchSize": 3000,
    "useJdbcBatch": true,
    "useTransactions": true,
    "excludeNonDeclaredFields": true
  },
  "className": "org.apache.pulsar.io.jdbc.MariadbJdbcAutoSchemaSink"
}
